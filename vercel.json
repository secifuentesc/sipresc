{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "sipresc.vercel.app" }
      ],
      "destination": "https://sipresc.co/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        { "type": "header", "key": "x-forwarded-proto", "value": "http" }
      ],
      "destination": "https://sipresc.co/$1",
      "permanent": true
    }
  ]
}
